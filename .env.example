# Configuracion de Docker Compose para OpsEvidence (desarrollo).
# Copiar a .env y ajustar. NO incluir secretos reales en el repositorio.

POSTGRES_DB=opsevidence
POSTGRES_USER=opsevidence
POSTGRES_PASSWORD=opsevidence
POSTGRES_PORT=5432

REDIS_PORT=6379

BACKEND_PORT=8010
FRONTEND_PORT=5180
FRONTEND_URL=http://localhost:5180
CORS_ALLOWED_ORIGINS=http://localhost:5180

VITE_API_URL=http://localhost:8010

# Sembrar datos de demostracion en el primer arranque (idempotente).
SEED_DEMO_DATA=true
