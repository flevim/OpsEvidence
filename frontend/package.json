{
  "name": "opsevidence-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Panel de OpsEvidence: evidencia de infraestructura y reportes para clientes.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,json,css}\""
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "axios": "^1.20.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4",
    "vuetify": "^3.13.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.6",
    "sass-embedded": "^1.104.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.12"
  }
}
